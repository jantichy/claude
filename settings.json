  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'p=$(jq -r \".tool_input.file_path // empty\"); case \"$p\" in *.py) python3 -m py_compile \"$p\";; esac; true'",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash -c 'p=$(jq -r \".tool_input.file_path // empty\"); case \"$p\" in *.ts|*.tsx) npx tsc --noEmit;; esac; true'",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/honza/.claude/iterm-notify.sh working",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/honza/.claude/iterm-notify.sh waiting",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/honza/.claude/iterm-notify.sh done",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/Users/honza/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
