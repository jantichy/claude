#!/bin/sh
# Při založení worktree ve worktree layoutu převezme lokální stav z main/.
#
# Pravidlo – co se symlinkuje, co klonuje a proč – drží ~/.claude/standards/worktree.md,
# sekce "Lokální stav se bere z main/". Hook ho vykonává, protože jako pokyn pro
# model nefungovalo: deny pravidla Edit(//**/.env*) v settings.json zastaví
# i `ln -s` na cestu .env, a Claude pak větev založí bez něj. Git hook spouští
# git, ne model, takže deny ho nevidí; výjimka je zapsaná v ~/.claude/standards/bypass.md.
#
# Obsah tajemství hook nikdy nečte ani nepřepisuje – jen zakládá odkaz do main/,
# respektive klonuje soubor, a existující soubor ve větvi nechá být.

# Delegace na lokální hook repozitáře – globální core.hooksPath ho jinak vypne.
# Důvody i tvar cesty viz githooks/commit-msg.
git_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null \
      || git rev-parse --git-dir 2>/dev/null)"
local_hook="$git_dir/hooks/post-checkout"
if [ -x "$local_hook" ] && [ "$local_hook" != "$0" ]; then
      "$local_hook" "$@" || exit $?
fi

# Nový worktree poznáme podle nulového předchozího HEAD; dostane ho i `git clone`,
# ten ale neleží v kontejneru a odpadne na další podmínce.
case "$1" in
      0000000000000000000000000000000000000000) ;;
      *) exit 0 ;;
esac

# Jen worktree layout: společný git adresář je <container>/.bare.
[ "$(basename "$git_dir")" = ".bare" ] || exit 0
container="$(dirname "$git_dir")"
main="$container/main"
worktree="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -d "$main" ] || exit 0
[ "$worktree" != "$main" ] || exit 0

# Adresář větve leží plochým jménem přímo v kontejneru, takže odkaz jde relativně
# a přežije přesun celého kontejneru; jinde se použije absolutní cesta.
if [ "$(dirname "$worktree")" = "$container" ]; then
      source_dir="../main"
else
      source_dir="$main"
fi

taken=""
for f in "$main"/.env "$main"/.env.*; do
      [ -f "$f" ] || continue
      name="$(basename "$f")"
      # Trackovaný soubor (.env.example) už ve větvi je – nepřepisuje se.
      if [ -e "$worktree/$name" ] || [ -L "$worktree/$name" ]; then
              continue
      fi
      case "$name" in
              # .env.local je soubor pro odchylky jedné instance (PORT), smí se rozejít.
              .env.local) cp -c "$f" "$worktree/$name" 2>/dev/null || cp "$f" "$worktree/$name" ;;
              *) ln -s "$source_dir/$name" "$worktree/$name" ;;
      esac && taken="$taken $name"
done

# Symlink by `npm install` ve větvi přepsal balíčky v main/. Klon jen na APFS,
# kde je instantní a nezabere místo; plná kopie by zakládání větve zdržela.
if [ -d "$main/node_modules" ] && [ ! -e "$worktree/node_modules" ]; then
      if cp -c -R "$main/node_modules" "$worktree/node_modules" 2>/dev/null; then
              taken="$taken node_modules/"
      else
              rm -rf "$worktree/node_modules"
              echo "post-checkout: node_modules/ se z main/ nepřevzal (klon nejde), spusť instalaci závislostí ve větvi" >&2
      fi
fi

[ -z "$taken" ] || echo "post-checkout: lokální stav převzatý z main/:$taken" >&2
exit 0